{
    "name": "virtual-connection/weclapp-mcp",
    "description": "Weclapp MCP SDK",
    "license": "MIT",
    "require": {
        "mcp/sdk": "^0.9.0",
        "guzzlehttp/guzzle": "^8.3",
        "php": "^8.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "pestphp/pest": "^5.3",
        "phpstan/phpstan": "^2.3",
        "laravel/pint": "^1.32",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "WeclappMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WeclappMcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "rector": "rector process --dry-run",
        "stan": "phpstan analyse",
        "test": "pest",
        "check" : ["@lint", "@rector", "@stan", "@test"]
    }
}
